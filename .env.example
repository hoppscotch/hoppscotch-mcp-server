# ── Hoppscotch MCP Server configuration ─────────────────────────────────────
#
# HOPPSCOTCH_SERVER_URL: the Hoppscotch frontend URL.
#   Cloud (default, omit to use):  https://hoppscotch.io
#   Self-hosted:                    https://your-hoppscotch.example.com
#
# The API URL and auth type are derived automatically:
#   hoppscotch.io / www.hoppscotch.io → api.hoppscotch.io    (Cloud / Firebase auth)
#   any other host                    → <server_url>/backend (self-hosted / JWT auth)
#
# HOPPSCOTCH_SERVER_URL=https://your-hoppscotch.example.com

# HOPPSCOTCH_ACCESS_TOKEN: override token (optional, advanced).
# If set, skips browser-based device login and uses this token directly.
# Note: Hoppscotch PATs (pat-xxx) only work with REST API endpoints, not
# GQL queries. For normal use, omit this and use device login instead.
# HOPPSCOTCH_ACCESS_TOKEN=

# ── Optional overrides ────────────────────────────────────────────────────────

# Tool surface to expose: minimal | core (default) | standard | full
# HOPPSCOTCH_TOOL_PROFILE=core

# Default team ID, used when no teamId is passed to team tools.
# HOPPSCOTCH_DEFAULT_TEAM_ID=your-team-id

# Request timeout in milliseconds (default: 30000)
# HOPPSCOTCH_TIMEOUT=30000

# How long a single tool call waits for browser sign-in before returning the
# login URL with retry guidance, in ms (default: 60000). The local callback
# server stays open ~5 min regardless, so a slower sign-in still completes.
# HOPPSCOTCH_AUTH_TIMEOUT_MS=60000

# Set true to let execute_request reach loopback/private/self-hosted targets
# (disables SSRF protection). Only enable on trusted input. (default: false)
# HOPPSCOTCH_ALLOW_PRIVATE_HOSTS=false

# Cap on the response body execute_request buffers, in bytes (default: 5000000).
# Larger responses are truncated.
# HOPPSCOTCH_MAX_RESPONSE_BYTES=5000000

# Set true to attempt browser login even when a headless environment is
# detected (default: false).
# HOPPSCOTCH_FORCE_BROWSER_LOGIN=false

# Origins allowed to receive `secret: true` environment values during
# execute_request/validate_response substitution. UNSET means no restriction
# (the default). Setting it opts in to the allowlist; set it empty to deny all.
# Comma-separated absolute origins.
# HOPPSCOTCH_SECRET_ALLOWED_ORIGINS=https://api.example.com,https://api2.example.com

# Set true to ignore trust-sensitive vars introduced by a working-directory
# .env file (they must then come from the real environment). Useful when the
# server runs in an editor that may open untrusted repos. (default: false)
# HOPPSCOTCH_STRICT_ENV=false

# Cloud Firebase Web API key. Normally unnecessary: released builds have it
# baked in at build time. Set it to override, or when building from source and
# using Cloud sign-in. Not needed for self-hosted instances.
# HOPPSCOTCH_FIREBASE_API_KEY=

# ── E2E tests ───────────────────────────────────────────────────────────────
# Only HOPPSCOTCH_TEAM_ID is required; all other resources (collections,
# environments) are self-provisioned in beforeAll and cleaned up in afterAll.
#
# HOPPSCOTCH_TEAM_ID=your-team-id
