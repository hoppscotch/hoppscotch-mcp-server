# pnpm security hygiene (this project uses pnpm, see packageManager in package.json)

# Cooldown: refuse dependency versions published less than 3 days (4320 minutes)
# ago. A freshly compromised publish then has time to be detected/yanked before
# it can be installed here. For an urgent, verified security patch newer than the
# window, allowlist the single package via `minimum-release-age-exclude[]=<name>`.
minimum-release-age=4320

# Pin exact versions on `pnpm add` (no caret/tilde ranges in the manifest).
save-exact=true

# Refuse to install/run under a Node that violates package.json "engines".
engine-strict=true
